@model G03_GestionDeCambios.Models.EstadisticasViewModel
@{
    ViewBag.Title = "Estadísticas del Proyecto";
    ViewBag.ProjectId = Model.IdProyecto;
}

<style>
    .kpi-card .card-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .kpi-number {
        font-size: 2.5rem;
        font-weight: 700;
    }

    .kpi-label {
        font-size: 1rem;
        color: #6c757d;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>@ViewBag.Title</h2>
        <p class="lead text-muted mb-0">Proyecto: @Model.NombreProyecto</p>
    </div>
</div>

<div class="row text-center mb-4">
    <div class="col-md-3"><div class="card kpi-card shadow-sm"><div class="card-body"><span class="kpi-number text-success">@Model.TareasCompletadas</span><span class="kpi-label">Tareas Completadas</span></div></div></div>
    <div class="col-md-3"><div class="card kpi-card shadow-sm"><div class="card-body"><span class="kpi-number text-warning">@Model.TareasPendientes</span><span class="kpi-label">Tareas Pendientes</span></div></div></div>
    <div class="col-md-3"><div class="card kpi-card shadow-sm"><div class="card-body"><span class="kpi-number text-info">@Model.TotalMiembros</span><span class="kpi-label">Miembros del Equipo</span></div></div></div>
    <div class="col-md-3"><div class="card kpi-card shadow-sm"><div class="card-body"><span class="kpi-number text-secondary">@Model.TotalDocumentos</span><span class="kpi-label">Documentos</span></div></div></div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header">Actividad por Miembro</div>
            <div class="card-body">
                @if (Model.ActividadPorMiembro.Any())
                {
                    <table class="table table-hover">
                        <thead><tr><th>Miembro</th><th class="text-center">Tareas Asignadas</th><th class="text-center">Documentos Subidos</th></tr></thead>
                        <tbody>
                            @foreach (var miembro in Model.ActividadPorMiembro)
                            {
                                <tr>
                                    <td>@miembro.NombreCompleto</td>
                                    <td class="text-center"><span class="badge bg-primary rounded-pill">@miembro.TareasAsignadas</span></td>
                                    <td class="text-center"><span class="badge bg-secondary rounded-pill">@miembro.DocumentosSubidos</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-center text-muted p-5">No hay actividad registrada por los miembros en este proyecto.</p>
                }
            </div>
        </div>
    </div>
</div>