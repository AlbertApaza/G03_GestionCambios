@model G03_GestionDeCambios.Models.AdministradorDashboardViewModel
@{
    ViewBag.Title = "Panel de Administración";
}

<h2>@ViewBag.Title</h2>
<p>Panel de control para la gestión completa del sistema.</p>
<hr />

<ul class="nav nav-tabs" id="adminTab" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" id="usuarios-tab" data-toggle="tab" href="#usuarios" role="tab" aria-controls="usuarios" aria-selected="true">Usuarios</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="proyectos-tab" data-toggle="tab" href="#proyectos" role="tab" aria-controls="proyectos" aria-selected="false">Proyectos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="config-tab" data-toggle="tab" href="#config" role="tab" aria-controls="config" aria-selected="false">Configuración</a>
    </li>
</ul>

<div class="tab-content" id="adminTabContent">
    <div class="tab-pane fade show active" id="usuarios" role="tabpanel" aria-labelledby="usuarios-tab">
        <div class="mt-3">
            <h4>Gestión de Usuarios</h4>
            <p>@Html.ActionLink("Crear Nuevo Usuario", "CreateUsuario", "Administrador", null, new { @class = "btn btn-success" })</p>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Nombre Completo</th>
                        <th>Email</th>
                        <th>Rol Admin</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Usuarios)
                    {
                        <tr>
                            <td>@item.idUsuario</td>
                            <td>@item.usuario</td>
                            <td>@item.nombre @item.apellido</td>
                            <td>@item.email</td>
                            <td>@(item.adminRol == 1 ? "Sí" : "No")</td>
                            <td>@(item.estado == 1 ? "Activo" : "Inactivo")</td>
                            <td>
                                @Html.ActionLink("Editar", "EditUsuario", new { id = item.idUsuario }) |
                                @Html.ActionLink("Detalles", "DetailsUsuario", new { id = item.idUsuario }) |
                                @Html.ActionLink("Eliminar", "DeleteUsuario", new { id = item.idUsuario })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade" id="proyectos" role="tabpanel" aria-labelledby="proyectos-tab">
        <div class="mt-3">
            <h4>Gestión de Proyectos</h4>
            <p>@Html.ActionLink("Crear Nuevo Proyecto", "CreateProyecto", "Administrador", null, new { @class = "btn btn-success" })</p>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Creador</th>
                        <th>Metodología</th>
                        <th>Fecha Inicio</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Proyectos)
                    {
                        <tr>
                            <td>@item.idProyecto</td>
                            <td>@item.nombre</td>
                            <td>@item.tbUsuarios.nombre</td>
                            <td>@item.tbMetodologias.nombre</td>
                            <td>@item.fechaInicio.ToShortDateString()</td>
                            <td>@(item.estado == 1 ? "Activo" : "Cerrado")</td>
                            <td>
                                @Html.ActionLink("Editar", "EditProyecto", new { id = item.idProyecto }) |
                                @Html.ActionLink("Detalles", "DetailsProyecto", new { id = item.idProyecto }) |
                                @Html.ActionLink("Eliminar", "DeleteProyecto", new { id = item.idProyecto })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade" id="config" role="tabpanel" aria-labelledby="config-tab">
        <div class="row mt-3">
            <div class="col-md-6">
                <h5>Metodologías</h5>
                <p>@Html.ActionLink("Crear Nueva", "CreateMetodologia", "Administrador", null, new { @class = "btn btn-sm btn-primary" })</p>
                <table class="table table-sm table-bordered">
                    @foreach (var item in Model.Metodologias)
                    {
                        <tr>
                            <td>@item.nombre</td>
                            <td class="text-right">
                                @Html.ActionLink("Editar", "EditMetodologia", new { id = item.idMetodologia }) |
                                @Html.ActionLink("Eliminar", "DeleteMetodologia", new { id = item.idMetodologia })
                            </td>
                        </tr>
                    }
                </table>
            </div>
            <div class="col-md-6">
                <h5>Roles</h5>
                <p>@Html.ActionLink("Crear Nuevo", "CreateRol", "Administrador", null, new { @class = "btn btn-sm btn-primary" })</p>
                <table class="table table-sm table-bordered">
                    @foreach (var item in Model.Roles)
                    {
                        <tr>
                            <td>@item.nombre</td>
                            <td>(@item.tbMetodologias.nombre)</td>
                            <td class="text-right">
                                @Html.ActionLink("Editar", "EditRol", new { id = item.idRol }) |
                                @Html.ActionLink("Eliminar", "DeleteRol", new { id = item.idRol })
                            </td>
                        </tr>
                    }
                </table>
            </div>
            <div class="col-md-6 mt-4">
                <h5>Elementos Configurables</h5>
                <p>@Html.ActionLink("Crear Nuevo", "CreateElemento", "Administrador", null, new { @class = "btn btn-sm btn-primary" })</p>
                <table class="table table-sm table-bordered">
                    @foreach (var item in Model.Elementos)
                    {
                        <tr>
                            <td>@item.nombre</td>
                            <td class="text-right">
                                @Html.ActionLink("Editar", "EditElemento", new { id = item.idElemento }) |
                                @Html.ActionLink("Eliminar", "DeleteElemento", new { id = item.idElemento })
                            </td>
                        </tr>
                    }
                </table>
            </div>
            <div class="col-md-6 mt-4">
                <h5>Ciclos/Fases</h5>
                <p>@Html.ActionLink("Crear Nuevo", "CreateCiclo", "Administrador", null, new { @class = "btn btn-sm btn-primary" })</p>
                <table class="table table-sm table-bordered">
                    @foreach (var item in Model.Ciclos)
                    {
                        <tr>
                            <td>@item.nombre</td>
                            <td>(@item.tbMetodologias.nombre)</td>
                            <td class="text-right">
                                @Html.ActionLink("Editar", "EditCiclo", new { id = item.codCiclo }) |
                                @Html.ActionLink("Eliminar", "DeleteCiclo", new { id = item.codCiclo })
                            </td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            $('#adminTab a').on('click', function (e) {
                e.preventDefault()
                $(this).tab('show')
            })
        });
    </script>
}