@model G03_GestionDeCambios.Models.ProyectoUsuariosViewModel
@{
    ViewBag.Title = "Asignar Usuarios al Proyecto";
}

<h2>@ViewBag.Title: @Model.NombreProyecto</h2>
<hr />

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-7">
        <h3>Usuarios Asignados Actualmente</h3>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre Completo</th>
                    <th>Email</th>
                    <th>Rol en Proyecto</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.UsuariosAsignados)
                {
                    <tr>
                        <td>@usuario.NombreCompletoUsuario</td>
                        <td>@usuario.EmailUsuario</td>
                        <td>@usuario.NombreRol</td> @* Mostrar el nombre del rol *@
                        <td>
                            @Html.ActionLink("Quitar", "QuitarUsuarioProyecto", new { idProyecto = Model.IdProyecto, idUsuario = usuario.IdUsuario }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('¿Está seguro de quitar este usuario del proyecto?');" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-5">
        <h3>Agregar Nuevo Usuario al Proyecto</h3>
        @using (Html.BeginForm("AgregarUsuario", "Proyecto", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdProyecto)
            @Html.HiddenFor(m => m.NombreProyecto)

            <div class="form-group mb-2">
                @Html.LabelFor(m => m.UsuarioAAgregarId, "Seleccione Usuario:", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.UsuarioAAgregarId, Model.TodosLosUsuarios, "-- Seleccione un Usuario --", new { @class = "form-control" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.RolParaNuevoUsuarioId, "Seleccione Rol para el Usuario en este Proyecto:", new { @class = "form-label" })
                @* La nota anterior ya no es necesaria *@
                @Html.DropDownListFor(m => m.RolParaNuevoUsuarioId, Model.RolesDisponibles, "-- Seleccione un Rol --", new { @class = "form-control" })
            </div>

            <button type="submit" class="btn btn-success">Agregar Usuario</button>
        }
    </div>
</div>

<hr />
<div class="mt-3">
    @Html.ActionLink("Volver a Detalles del Proyecto", "Details", "Proyecto", new { id = Model.IdProyecto }, new { @class = "btn btn-info" }) @* Asumiendo una vista Details *@
    @Html.ActionLink("Ir a Gestión de Elementos", "Elementos", "Proyecto", new { idProyecto = Model.IdProyecto }, new { @class = "btn btn-secondary" })
</div>
