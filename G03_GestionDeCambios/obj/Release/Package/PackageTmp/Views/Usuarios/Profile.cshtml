@model G03_GestionDeCambios.Models.UsuarioViewModel
@{
    ViewBag.Title = "Perfil de Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-3 text-center mb-3 mb-md-0">
                    <img src="@Model.FotoPerfilUrlCompleta"
                         alt="Foto de perfil de @Model.NombreCompletoDisplay"
                         class="img-fluid rounded-circle"
                         style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #fff; box-shadow: 0 0 10px rgba(0,0,0,0.1);" />
                </div>
                <div class="col-md-9">
                    <h2 class="mb-1">@Model.NombreCompletoDisplay</h2>
                    <p class="text-muted fs-5 mb-2">@@@Model.NombreUsuarioLogin</p>
                    <p class="mb-1"><i class="bi bi-envelope-fill me-2 text-primary"></i>@Model.Email</p>
                    <p class="mb-0"><i class="bi bi-calendar-check-fill me-2 text-primary"></i>Miembro desde: @(Model.FechaCreacion.HasValue ? Model.FechaCreacion.Value.ToString("dd 'de' MMMM 'de' yyyy") : "N/D")</p>
                    <a href="@Url.Action("Settings", "Usuarios")" class="btn btn-primary btn-sm mt-3">
                        <i class="bi bi-pencil-square me-1"></i> Editar Perfil
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0" style="background: var(--bs-body-bg, #ffffff); border: 1px solid var(--bs-border-color, #dee2e6);">
                <div class="card-body py-4 px-4">
                    <div class="row align-items-center">
                        <div class="col-2">
                            <i class="bi bi-person-badge" style="font-size: 2.5rem; color: #5e72e4; opacity: 0.8;"></i>
                        </div>
                        <div class="col-10">
                            <h6 class="card-title mb-2 text-muted">Método de Registro</h6>
                            @if (Model.MetodoRegistro == "Google")
                            {
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-google me-2" style="font-size: 1.25rem;"></i>
                                    <span class="fw-bold" style="font-size: 1.5rem;">
                                        <span style="color: #4285f4;">G</span><span style="color: #ea4335;">o</span><span style="color: #fbbc05;">o</span><span style="color: #4285f4;">g</span><span style="color: #34a853;">l</span><span style="color: #ea4335;">e</span>
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-key-fill me-2 text-info" style="font-size: 1.25rem;"></i>
                                    <h5 class="fw-bold mb-0 text-body">Credenciales</h5>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0" style="background: var(--bs-body-bg, #ffffff); border: 1px solid var(--bs-border-color, #dee2e6);">
                <div class="card-body py-4 px-4">
                    <div class="row align-items-center">
                        <div class="col-2">
                            <i class="bi bi-briefcase-fill" style="font-size: 2.5rem; color: #4caf50; opacity: 0.8;"></i>
                        </div>
                        <div class="col-10">
                            <h6 class="card-title mb-2 text-muted">Proyectos Asignados</h6>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-folder-fill me-2 text-success" style="font-size: 1.25rem;"></i>
                                <h2 class="fw-bold mb-0 text-body">@Model.CantidadProyectos</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>